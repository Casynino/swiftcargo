  assignedToId String?
  assignedTo   User?   @relation("SourcingAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?   @relation("SourcingCreator", fields: [createdById], references: [id], onDelete: SetNull)

  outcome String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
