/// Append-only history of a case.
model ExceptionEvent {
  id String @id @default(cuid())

  caseId String
  case   ExceptionCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  from ExceptionStatus?
  to   ExceptionStatus?
  note String

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
}

// ---------------------------------------------------------------------------
// Customer communication
// ---------------------------------------------------------------------------

enum ConversationStatus {
  OPEN
  WAITING_CUSTOMER
  WAITING_STAFF
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Conversation {
  id String @id @default(cuid())

  reference String @unique // TKT-2026-000125

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  /// What it is about, when it is about something. A general question has none.
  cargoId String?
  cargo   Cargo?  @relation(fields: [cargoId], references: [id], onDelete: SetNull)

  subject  String
  status   ConversationStatus @default(OPEN)
  /// How soon somebody should answer. Urgent reaches the top of the desk.
  priority TicketPriority     @default(NORMAL)

  assignedToId String?
  assignedTo   User?   @relation("ConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  lastMessageAt  DateTime @default(now())
  /// Unread by staff. The support inbox is ordered on this.
  staffUnread    Boolean  @default(true)
  customerUnread Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([status, lastMessageAt])
  @@index([customerId, lastMessageAt])
}

model Message {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)

  /// Staff author. Null means the customer wrote it.
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  body String

  /// NEVER SHOWN TO THE CUSTOMER. A note staff leave each other on the thread,
  /// in the thread, because the alternative is WhatsApp.
  internal Boolean @default(false)

  attachments Json?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

/// Addressed to a staff user OR a customer, never broadcast. A notification
/// with no clear reader is an announcement, and announcements are addressed
/// explicitly.
/// WHAT WE TOLD A CUSTOMER, AND WHO TOLD THEM.
///
/// The system does not deliver anything. It composes the wording and opens
/// WhatsApp with it; a person presses send. So a row here means "we contacted
/// them" and never "the system notified them" — anything stronger would be a
/// claim the code cannot back up when a customer says nobody rang.
///
/// Kept because the question "did anyone tell them the cargo landed" is asked
/// constantly, and the honest answer has to be findable on the cargo record
/// rather than in somebody's phone.
model CustomerContact {
  id String @id @default(cuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  cargoId String?
  cargo   Cargo?  @relation(fields: [cargoId], references: [id], onDelete: SetNull)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  /// "cargo.received_china", "invoice.issued", "payment.reminder", …
  kind    String
  /// WHATSAPP, PHONE, SMS, EMAIL, IN_PERSON.
  channel String @default("WHATSAPP")

  /// Exactly what was put in front of the customer, as sent.
  body String

  sentById String?
  sentBy   User?   @relation("ContactSentBy", fields: [sentById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([cargoId, createdAt])
  @@index([invoiceId])
  @@index([createdAt])
}

model Notification {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  kind  String // "cargo.received", "container.departed", "invoice.issued", …
  title String
  body  String?
  /// Where "open" goes. Null when there is nowhere to go.
  href  String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([customerId, readAt])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([customerId, createdAt])
}

// ---------------------------------------------------------------------------
// Requests off the public website
// ---------------------------------------------------------------------------

/// A request is NOT cargo and NOT a booking. It is a promise typed by somebody
/// who is not standing in the warehouse, and it becomes real only when a member
/// of staff acts on it. Keeping the two apart is what stops the operation from
/// having to trust a number a stranger entered.
enum RequestStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  SCHEDULED
  COMPLETED
  CANCELLED
  REJECTED
}

enum BookingType {
  FULL_CONTAINER
  /// Loose cargo consolidated with other customers. The company's own word for
  /// it on every screen is "loose cargo"; the enum keeps the name it was born
  /// with, because renaming a stored value to improve a label is a migration
  /// that can only lose rows.
  SHARED_CARGO
  /// Out of gauge, heavy lift, a machine on a frame. Never priced from the rate
  /// book — somebody looks at it.
  SPECIAL_CARGO
  /// Clearing somebody else's cargo through Dar. No freight, no sailing.
  CUSTOMS_CLEARANCE
}

model ContainerBooking {
  id String @id @default(cuid())

  reference String @unique // BK-000125

  type BookingType

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  contactName  String
  contactPhone String
  contactEmail String?

  pickupAddress String?
  destination   String?
  commodity     String?

  containerType  ContainerType?
  dangerousGoods Boolean        @default(false)

  packages          Int?
  quantity          Int?
  dimensions        String?
  estimatedWeightKg Decimal? @db.Decimal(12, 3)
  estimatedCbm      Decimal? @db.Decimal(12, 4)

  preferredShipment    String?
  /// The departure date of the sailing the customer picked off the public
  /// schedule, when they picked one. A date rather than the sentence they saw,
  /// so Support can line the request up against the boat it asked for.
  preferredSailingDate DateTime? @db.Date

  /// Where the goods are now, and when they will be ready to move.
  originCity    String?
  readinessDate DateTime?
  supplierName  String?

  /// How the cargo has to be handled. Hazardous is `dangerousGoods` above; the
  /// other two ride beside it because a shipper ticks all three on one form.
  fragile    Boolean @default(false)
  perishable Boolean @default(false)
  /// Special cargo only: lifting, cradling, temperature, escorts.
  handling   String?

  /// Customs clearance only. Nothing here is freight — it is somebody else's
  /// container arriving at a port with papers that need working.
  portOfDischarge       String?
  shipmentRef           String?
  declaredValue         Decimal? @db.Decimal(14, 2)
  declaredValueCurrency String   @default("USD")

  requirements  String?
  termsAccepted Boolean @default(false)

  status     RequestStatus @default(SUBMITTED)
  staffNotes String?

  assignedToId String?
  assignedTo   User?   @relation("BookingAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  /// What Support came back with. A figure here is an answer to an enquiry, not
  /// an invoice: nothing is owed until cargo exists and Finance issues a bill.
  quotedAmount   Decimal?  @db.Decimal(14, 2)
  quotedCurrency String    @default("USD")
  quotedAt       DateTime?

  /// SET AT CONVERSION AND NOWHERE ELSE.
  ///
  /// An approved request becomes operational by being attached to a customer on
  /// the books — found by phone before one is created, so answering the same
  /// enquiry twice cannot mint two customers. The form can never write it.
  convertedCustomerId String?
  convertedCustomer   Customer? @relation("BookingConverted", fields: [convertedCustomerId], references: [id], onDelete: SetNull)
  convertedAt         DateTime?

  documents RequestDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
  @@index([assignedToId, status])
}

model PickupRequest {
  id String @id @default(cuid())

  reference String @unique // PU-000125

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  pickupLocation  String
  /// The Guangzhou-area city the address is in. Held apart from the address so
  /// the floor can sort a morning's runs by town.
  city            String?
  contactName     String
  contactPhone    String
  contactWhatsapp String?
  contactEmail    String?

  /// The factory. Not a customer — Swift Cargo bills nobody here — but the only
  /// thread back to an owner when a mark goes missing.
  supplierName    String?
  supplierContact String?

  cargoDescription  String?
  packages          Int?
  commodity         String?
  estimatedCbm      Decimal? @db.Decimal(12, 4)
  estimatedWeightKg Decimal? @db.Decimal(12, 3)
  /// What the customer says will be written on the boxes. A claim, not the mark
  /// on the customer row — the counter decides that when the goods arrive.
  shippingMark      String?

  preferredDate DateTime?
  preferredTime String?
  notes         String?

  status     RequestStatus @default(SUBMITTED)
  staffNotes String?

  assignedToId  String?
  assignedTo    User?     @relation("PickupAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  /// The day Guangzhou is actually going. Never the day the customer asked for.
  scheduledDate DateTime?
  completedAt   DateTime?

  /**
   * A PICKUP REQUEST IS NOT CARGO.
   * It stays a request until the boxes are physically on the Guangzhou floor
   * and a clerk takes them in through the receiving counter. This points at the
   * consignment that came of it, and is written only by that act.
   */
  cargoId String?
  cargo   Cargo?  @relation("PickupCargo", fields: [cargoId], references: [id], onDelete: SetNull)

  documents RequestDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
  @@index([assignedToId, status])
}

/// A file hung on a website request: a proforma the customer sent in, a photo
/// of the pallet the Guangzhou driver took at the factory gate. Uploaded by
/// staff only — see lib/actions/request-files.ts — and read back through
/// /api/files like every other private paper.
model RequestDocument {
  id String @id @default(cuid())

  pickupRequestId String?
  pickupRequest   PickupRequest?    @relation(fields: [pickupRequestId], references: [id], onDelete: Cascade)
  bookingId       String?
  booking         ContainerBooking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// DOCUMENT for paperwork, PROOF for evidence the job was done.
  kind  String  @default("DOCUMENT")
  label String?
  url   String

  uploadedById String?
  uploadedBy   User?   @relation("RequestDocumentBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([pickupRequestId])
  @@index([bookingId])
}

model QuoteRequest {
  id String @id @default(cuid())

  reference String @unique // QT-000125

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  contactName  String
  contactPhone String
  contactEmail String?

  service           ServiceType @default(LCL)
  commodity         String?
  originCity        String?
  destination       String?
  estimatedCbm      Decimal?    @db.Decimal(12, 4)
  estimatedWeightKg Decimal?    @db.Decimal(12, 3)
  hazardous         Boolean     @default(false)
  fragile           Boolean     @default(false)
  notes             String?

  quotedAmount   Decimal?  @db.Decimal(14, 2)
  quotedCurrency String    @default("USD")
  quotedAt       DateTime?
  quoteExpiresAt DateTime?
  responseNotes  String?

  status RequestStatus @default(SUBMITTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
}

/// Where a sailing is in its booking window. Not ShipmentStatus: that describes
/// a voyage that exists and is being worked, and this describes whether a
/// customer may still put cargo on a boat that has not been booked yet.
enum SailingStatus {
  OPEN_FOR_BOOKING
  CUTOFF_APPROACHING
  CLOSED
  DEPARTED
  IN_TRANSIT
  ARRIVED
  DELAYED
  CANCELLED
}

/**
 * A SAILING THE WEBSITE PUBLISHES, WHEN IT DIFFERS FROM THE WEEKLY RULE.
 * The schedule is a rule, not a list: cargo is received until Friday, the box
 * is packed that Friday, the ship leaves Monday, and it is thirty days at sea.
 * lib/sailing-schedule.ts generates the weeks from that rule, so the public
 * page is never a table of dates somebody has to remember to extend.
 * A row here is an EXCEPTION to the rule — a week that slipped, a vessel worth
 * naming, a public holiday that moved the deadline, a week cancelled outright.
 * `weekOf` names the generated week it replaces; a row without one is an extra
 * sailing the rule does not describe.
 */
model ShipmentSchedule {
  id String @id @default(cuid())

  /// The Monday of the generated week this row stands in for. Unique, so two
  /// staff cannot publish two versions of the same week. Null for an extra
  /// sailing that answers to no generated week.
  weekOf DateTime? @unique @db.Date

  origin      String @default("Guangzhou")
  destination String @default("Dar es Salaam")

  /// Last day the Guangzhou warehouse accepts cargo for this sailing.
  cargoDeadline    DateTime
  /// The day the box is packed. The same Friday under the rule, and the reason
  /// it is stored separately is the week where it is not.
  loadingDate      DateTime?
  departureDate    DateTime
  /// Days at sea. Stored rather than assumed, because thirty is this lane's
  /// habit and not a law.
  transitDays      Int       @default(30)
  estimatedArrival DateTime

  vessel       String?
  voyage       String?
  shippingLine String?

  /// Linked once the box exists. Null while the sailing is only announced.
  containerId String?

  status    SailingStatus @default(OPEN_FOR_BOOKING)
  published Boolean       @default(true)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, departureDate])
}

/// Guangzhou market and sourcing information for the public site.
enum SourcingStatus {
  NEW
  IN_PROGRESS
  WAITING_CUSTOMER
  SUPPLIER_FOUND
  COMPLETED
  CANCELLED
}

/// A customer asks us to find something in China. Support works it from first
