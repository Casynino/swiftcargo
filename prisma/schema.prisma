// ---------------------------------------------------------------------------
// Audit and system
// ---------------------------------------------------------------------------

/// Append-only. Who did what, and what the figures were on either side.
model AuditLog {
  id String @id @default(cuid())

  actorId    String?
  actor      User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?
  actorRole  Role?

  action   String // "cargo.received", "payment.verified", "cbm.override"
  entity   String
  entityId String?

  summary  String
  metadata Json?

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entity, entityId, createdAt])
  @@index([entity, action, createdAt])
  @@index([createdAt])
}

/// A single field changing, with both values. Separate from AuditLog because a
/// weight correction is asked about by field ("what has this weight been?"),
/// and searching a summary string for it does not work.
model FieldChange {
  id String @id @default(cuid())

  entity   String
  entityId String
  field    String

  oldValue String?
  newValue String?
  reason   String?

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
}

/**
 * WHERE THE MONEY IS PAID IN.
 * Printed on every invoice, four at a time — shillings and dollars at two
 * banks, because a customer paying in the wrong currency at the wrong bank is a
 * week of reconciling. Rows rather than settings columns: banks are opened and
 * closed, and a closed account must stop printing without a deploy.
 */
enum AccountKind {
  BANK
  MOBILE_MONEY
  CASH
}

model BankAccount {
  id String @id @default(cuid())

  bankName      String
  accountName   String
  accountNumber String
  branch        String?

  /// A bank, a mobile-money line or a tin on a desk. They behave differently
  /// enough that the screen names which it is: a tin can be counted against
  /// what the ledger says, and a bank cannot.
  kind AccountKind @default(BANK)

  /**
   * WHAT WAS IN IT WHEN IT WAS PUT ON THE SYSTEM.
   * Every balance here is the ledger added up, so an account that existed
   * before this software did would start at zero and disagree with the bank
   * forever. This is the one figure somebody types, and it is dated so the
   * disagreement has a beginning.
   */
  openingBalance   Decimal   @default(0) @db.Decimal(14, 2)
  openingBalanceAt DateTime?

  /// "TZS" or "USD". Printed beside the bank so nobody guesses.
  currency String @default("TZS")

  /// Lowest first, so the order on paper is the order somebody chose.
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments     Payment[]
  expenses     ContainerExpense[]
  transfersOut AccountTransfer[]  @relation("TransferFrom")
  transfersIn  AccountTransfer[]  @relation("TransferTo")
  counts       CashCount[]
  payrollRuns  PayrollRun[]

  @@index([active, sortOrder])
}

/**
 * MONEY CHANGING SHELVES.
 * Banking the day's takings, topping up the tin, converting dollars. Neither
 * income nor a cost — the business is no richer afterwards — but both accounts
 * move, and an account balance that ignores this disagrees with the bank the
 * first time somebody makes a deposit.
 * The charge is kept apart from the amount because it IS a cost: the money that
 * left the first account is not all the money that reached the second, and the
 * difference is the bank's.
 */
model AccountTransfer {
  id String @id @default(cuid())

  reference String @unique // TRF-2026-000125

  fromAccountId String
  fromAccount   BankAccount @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)

  toAccountId String
  toAccount   BankAccount @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)

  /// What left the first account.
  amount        Decimal @db.Decimal(14, 2)
  /// What the bank took. Zero when there was none.
  charge        Decimal @default(0) @db.Decimal(14, 2)
  /// What reached the second. Defaults to amount − charge, but a currency
  /// conversion makes the two unrelated, so it is stored rather than derived.
  amountArrived Decimal @db.Decimal(14, 2)

  purpose      String?
  transferDate DateTime @default(now())

  recordedById String?
  recordedBy   User?   @relation("TransferRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  cancelledAt     DateTime?
  cancelledReason String?

  createdAt DateTime @default(now())

  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([transferDate])
}

/**
 * WHAT IS PHYSICALLY IN THE TIN, AGAINST WHAT THE LEDGER SAYS.
 * The count never changes a balance. The balance is the ledger added up and it
 * cannot disagree with its own history — so a count that comes up short is
 * evidence of a movement nobody recorded, and the fix is to record it, not to
 * overwrite the total.
 */
model CashCount {
  id String @id @default(cuid())

  accountId String
  account   BankAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  /// What was on the desk.
  counted  Decimal @db.Decimal(14, 2)
  /// What the ledger said at that moment, kept so a later correction to the
  /// history cannot quietly rewrite what the count found.
  expected Decimal @db.Decimal(14, 2)

  note String?

  countedById String?
  countedBy   User?   @relation(fields: [countedById], references: [id], onDelete: SetNull)

  countedAt DateTime @default(now())

  @@index([accountId, countedAt])
}

/// Where a record stands with the manager. PENDING is the absence of a verdict
/// and is never written; it is here so the screens and the filter share one
/// vocabulary with the table.
enum ReviewState {
  PENDING
  /// Asked the desk that recorded it a question. Nothing is disputed yet — the
  /// record is not understood.
  QUERIED
  /// The system figure and the figure from outside it disagree. Says nothing
  /// about whose fault.
  MISMATCH
  /// Handed back to the desk that recorded it, with a reason. The record itself
  /// is untouched; only this says it is disputed.
  SENT_BACK
  /// Being looked into. Parked deliberately rather than forgotten.
  UNDER_REVIEW
  /// Looked at, and it agrees with the evidence.
  RECONCILED
}

/**
 * A MANAGER'S VERDICT ON A RECORD, KEPT BESIDE IT AND NEVER INSIDE IT.
 * Sending a payment back does not edit the payment — Finance still sees exactly
 * what they entered, and this row says a manager disputes it and why. The desk
 * corrects it through its own path (a reversal, a cancellation), which already
 * leaves both versions on the books.
 * Append-only: "sent back on Monday, reconciled on Friday" is two rows, because
 * the sequence is what somebody asks about six months later. The current
 * standing of a record is its newest row.
 * `entity` is polymorphic ("Payment", "Expense", "Transfer", "Container") on
 * purpose — four nullable foreign keys would answer the same question worse.
 * `actualAmount` is the figure from outside the system when the manager has
 * one: the slip, the statement line, the till. It is evidence beside the
 * record, never a correction of it.
 */
model ManagerReview {
  id String @id @default(cuid())

  entity   String
  entityId String

  verdict ReviewState

  actualAmount Decimal? @db.Decimal(14, 2)
  /// The currency `actualAmount` was read in — the record's own.
  currency     String?

  note String?

  reviewerId String
  reviewer   User   @relation("ManagerReviewBy", fields: [reviewerId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([verdict])
}

enum PickupNoteStatus {
  ACTIVE
  USED
  CANCELLED
}

/**
 * THE CUSTOMER'S PERMISSION TO COLLECT.
 * Issued by Finance the moment a consignment is paid in full, and it is what
 * the customer brings — or shows on a phone — to the Dar counter. The warehouse
 * does not decide whether goods may go; it reads the note and checks the box.
 * The amount is a SNAPSHOT, not a live figure. A note in somebody's hand has to
 * stay truthful about what was settled on the day it was issued, even if the
 * invoice is adjusted afterwards.
 * One per consignment, because a consignment is what gets handed over. Marked
 * USED when the cargo is released, so the same note cannot walk in twice.
 */
model PickupNote {
  id         String @id @default(cuid())
  noteNumber String @unique // PN-2026-000123

  cargoId String @unique
  cargo   Cargo  @relation(fields: [cargoId], references: [id], onDelete: Restrict)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  /// What the customer had settled when the note was written.
  amountPaid Decimal  @db.Decimal(14, 2)
  currency   String   @default("USD")
  /// The shillings figure they actually handed over, when one was recorded.
  amountTzs  Decimal? @db.Decimal(16, 2)

  /// Scanned at the counter. Random, for the same reason a label's code is.
  qrToken String @unique @default(cuid())

  status PickupNoteStatus @default(ACTIVE)

  /**
   * LET GO BEFORE THE MONEY ARRIVED.
   * The rule is that nothing leaves unpaid, and this is the recorded exception
   * to it: a named person decided, for a stated reason, and the debt stays on
   * the books. It is never a silent override — a note that says "on credit"
   * reads differently at the counter, and the customer still owes.
   */
  onCredit     Boolean   @default(false)
  creditReason String?
  /// When the customer agreed to have paid by, on a credit release.
  creditDueAt  DateTime?

  issuedById String?
  issuedBy   User?    @relation("PickupNoteIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  issuedAt   DateTime @default(now())

  usedAt       DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  @@index([status, issuedAt])
  @@index([customerId])
  @@index([onCredit, status, issuedAt])
}

/// Document number sequences. Incremented inside the caller's transaction, so
/// two clerks pressing Save in the same second cannot collide.
model Counter {
  key   String @id
  value Int    @default(0)
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Company details that appear on printed documents and the public site.
model CompanySetting {
  id String @id @default("singleton")

  name     String  @default("Swift Cargo")
  tagline  String? @default("On time, Every time")
  email    String?
  phone    String?
  altPhone String?
  whatsapp String?

  darAddress   String?
  chinaAddress String?

  /**
   * THE TWO LEGAL ENTITIES.
   * "Swift Cargo" is the trading name; the companies that actually sign for
   * goods are different at each end, and both appear on printed documents.
   * The Guangzhou entity receives in China; the Tanzanian one is the consignee
   * every container is addressed to.
   */
  chinaEntity String?
  darEntity   String?

  /// Postal address printed under the consignee on the packing list.
  darPostal String?

  tin String?
  vrn String?

  /// The VAT percentage applied to new invoices. On the row rather than in code
  /// because a tax rate is a thing that changes by law, not by deploy.
  vatPercent Decimal @default(18) @db.Decimal(5, 2)

  /// Whether the rate book's prices already contain VAT. By the owner's
  /// decision they do: a rate of 380 is 380 on the bill, with the VAT inside it
  /// shown, never 18% added on top. Each invoice pins the answer it was
  /// priced under (`Invoice.vatInclusive`).
  pricesIncludeVat Boolean @default(true)

  /// Free storage days at the Dar warehouse before charges begin.
  freeStorageDays Int @default(7)

  /**
   * WHAT A DAY ON THE DAR FLOOR COSTS, PER CONSIGNMENT.
   * Zero means storage is not charged, and that is the default: a rate nobody
   * has agreed is a rate that must not appear on a customer's bill. Set it in
   * settings and the charge becomes available on the invoice, never automatic —
   * a clerk presses "Add storage" and can waive it, because whether to charge a
   * customer who was three days late is a commercial decision, not arithmetic.
   */
  storagePerDay   Decimal @default(0) @db.Decimal(12, 2)
  /// The currency that rate is quoted in. Billed in the invoice's currency.
  storageCurrency String  @default("USD")

  /**
   * THE TERMS PRINTED UNDER EVERY INVOICE.
   * One line each, newline separated. On the row and not in the code because
   * the payment window, the storage charge and the complaints window are
   * commercial decisions somebody changes without asking a programmer.
   */
  invoiceTerms String?

  updatedAt DateTime @updatedAt
}

/**
 * ONE PHYSICAL BOX, ONE CODE.
 * A package line says "74 cartons of filters" — one description, one volume,
 * one rate. The warehouse handles seventy-four cartons, and each one gets its
 * own sticker and its own code, so the Dar counter can say which of the
 * seventy-four has arrived, which is damaged and which has been handed over.
 * Created with the line and kept in step with its count; never merged, never
 * shared between two boxes, and never reused.
 * The consignment (Cargo) is the receipt that groups a customer's boxes; the
 * container only organises them. Neither has a code of its own on a sticker.
 * Each physical event is a timestamp with the person who did it, set once. A
 * box that is found after being reported missing keeps both facts.
 */
model CargoBox {
  id String @id @default(cuid())

  cargoId   String
  cargo     Cargo        @relation(fields: [cargoId], references: [id], onDelete: Restrict)
  packageId String
  package   CargoPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)

  /// "Box 7 of 12" across the whole consignment, in line order.
  sequence Int

  /// Random, never the reference, for the same reason as every other label code.
  qrToken String @unique

  darReceivedAt   DateTime?
  darReceivedById String?
  darContainerId  String?

  damagedAt   DateTime?
  damagedById String?
  damageNote  String?

  missingAt   DateTime?
  missingById String?

  collectedAt   DateTime?
  collectedById String?
  /// The pickup note it was handed over against, when there was one.
  pickupNoteId  String?

  /// A box taken off a line before Dar ever saw it (a count corrected down in
  /// Guangzhou). Kept, never deleted, so a printed sticker still scans to an
  /// answer rather than to nothing.
  voidedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scans ScanEvent[]

  @@unique([cargoId, sequence])
  @@index([packageId])
}

/**
 * EVERY SCAN, INCLUDING THE ONES THAT FAILED.
 * Who pointed a scanner at what, where, and what the system said back. A code
 * that resolves to nothing is recorded too — a run of unknown codes at a
 * counter is the first sign of a forged or reprinted label.
 */
model ScanEvent {
  id String @id @default(cuid())

  /// Exactly what was scanned, so a failed scan can be looked into.
  token String

  boxId   String?
  box     CargoBox? @relation(fields: [boxId], references: [id], onDelete: SetNull)
  cargoId String?
  cargo   Cargo?    @relation(fields: [cargoId], references: [id], onDelete: SetNull)

  userId     String?
  role       String?
  department String?

  /// Where it was scanned: lookup, dar-receiving, release, damage…
  workflow String
  /// What was done: opened, received, released, marked-damaged…
  action   String
  /// ok, warning, refused, unknown
  result   String
  detail   String?

  containerId String?

  createdAt DateTime @default(now())

  @@index([boxId, createdAt])
  @@index([cargoId, createdAt])
  @@index([createdAt])
}


/**
 * THE BUSINESS'S OWN VOCABULARY, IN BOTH LANGUAGES.
 *
 * The goods this company ships repeat: cigarette paper, ladies' shoes,
 * motorcycle spares. A term in this book is rendered the same way every time,
 * instantly and for nothing — which a translation service cannot promise, and
 * a warehouse cannot reconcile a vocabulary that drifts under it. Learned from
 * lines the clerks describe in both languages; a person's pairing is never
 * replaced by a guess.
 */
model CargoTerm {
  id String @id @default(cuid())

  /// The Chinese term, normalised — the key both directions use.
  zh String @unique
  en String

  source    TermSource @default(SEEDED)
  timesUsed Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([en])
}

enum TermSource {
  /// Taken from cargo already described in both languages.
  SEEDED
  /// Typed by a member of staff.
  STAFF
  /// Returned by a translation service.
  MACHINE
}
