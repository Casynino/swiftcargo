# Swift Cargo environment. Copy to .env for local development. On Vercel, set
# these under Project → Settings → Environment Variables (docs/DEPLOY.md).
# A production server refuses to start while a required one is missing or
# unusable (lib/env.ts, checked from instrumentation.ts).

# ── Database ────────────────────────────────────────────────────────────────
# Postgres. DIRECT_URL is used by Prisma migrate; DATABASE_URL may be pooled.
# Locally both are the same address. On Neon (see docs/DEPLOY-DATABASE.md):
#   DATABASE_URL = the -pooler host, with ?sslmode=require&pgbouncer=true&connection_limit=5
#   DIRECT_URL   = the host without -pooler, with ?sslmode=require
# Required. DIRECT_URL must also be present at build time on Vercel, where
# `npm run vercel-build` runs `prisma migrate deploy`.
DATABASE_URL="postgresql://user:password@localhost:5432/swiftcargo?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/swiftcargo?schema=public"

# ── Sign-in ─────────────────────────────────────────────────────────────────
# Required. Signs the session cookie; at least 32 characters.
# `openssl rand -base64 32`. NEXTAUTH_SECRET is accepted in its place.
AUTH_SECRET=""
# The host header is trusted (auth.config.ts sets trustHost); kept for tooling
# that reads it. AUTH_URL is not needed on Vercel.
AUTH_TRUST_HOST=true

# ── Public address ──────────────────────────────────────────────────────────
# Required in production: https, not localhost. Printed inside the QR code on
# every package label and pickup note, and used for the sitemap, metadata and
# customer tracking links. Written into the build, so change it and redeploy.
NEXT_PUBLIC_SITE_URL="http://localhost:3177"

# ── Uploaded files ──────────────────────────────────────────────────────────
# With a token, photos, payment slips and receipts go to a PRIVATE Vercel Blob
# store and are served only through /api/files. Required on Vercel (its disk
# does not persist). Created by connecting a Blob store to the project.
BLOB_READ_WRITE_TOKEN=""
# Without a token, files are written here instead. Outside the public folder.
# Defaults to ./storage/uploads; must be persistent disk.
UPLOAD_DIR=""

# ── First production seed (`npm run db:seed:production`) ────────────────────
# Read once and nowhere else. ADMIN_PASSWORD needs 12+ characters with upper,
# lower, digit and symbol. Remove both from the environment after the seed.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""
# Optional company details written to settings on first seed (editable later
# at /app/admin/settings).
COMPANY_EMAIL=""
COMPANY_PHONE=""
COMPANY_WHATSAPP=""
COMPANY_TIN=""
COMPANY_VRN=""
# SEED_MARKETS=false skips the public markets directory; SEED_RATE_BOOK=true
# loads the old system's rate book (Finance must confirm the figures first).
SEED_MARKETS=""
SEED_RATE_BOOK=""

# ── Development only ────────────────────────────────────────────────────────
# Seeded staff accounts all share this password. Never set it in production.
SEED_ADMIN_PASSWORD="choose-a-local-dev-password"

# Set by Vercel itself; listed so nobody sets them by hand.
# VERCEL, VERCEL_PROJECT_PRODUCTION_URL, NODE_ENV, NEXT_RUNTIME, NEXT_PHASE
